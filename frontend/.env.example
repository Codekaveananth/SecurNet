# Optional Spring Boot gateway. When set, the UI tries it first and falls back
# to the ML service. Leave it empty if you are not running the gateway.
VITE_GATEWAY_URL=
VITE_ML_URL=http://localhost:8000
# Only if the ML service runs with SECURENET_API_KEY set. This value ends up
# in the browser bundle, so it is a deployment gate, not a user secret.
VITE_API_KEY=
