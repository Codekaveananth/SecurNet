{
  "manifest_version": 3,
  "name": "SecureNet: phishing and UPI scam protection",
  "version": "1.1.0",
  "description": "Checks each site as you navigate to it with the SecureNet phishing model and explains its verdict. Sends only the address, never page content.",
  "minimum_chrome_version": "116",

  "permissions": ["storage", "tabs", "webNavigation", "notifications", "sidePanel"],

  "host_permissions": [
    "http://localhost:8000/*",
    "http://localhost:8080/*",
    "http://127.0.0.1:8000/*",
    "http://127.0.0.1:8080/*"
  ],
  "optional_host_permissions": ["https://*/*"],

  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/warning.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"],
      "js": ["content/bridge.js"],
      "run_at": "document_start"
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SecureNet",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "side_panel": { "default_path": "popup/popup.html?panel=1" },
  "options_page": "options/options.html",

  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
